# Copy this file to .env and fill it in:  cp env.example .env
#
# (The file is named env.example rather than .env.example only because the
# tooling that generated it could not create dot-env files. Renaming it to
# .env.example is safe; .gitignore already whitelists that name.)

# Required. The admin credential. It can create tenants, issue and revoke API
# keys and start pairing. It can NOT send messages or read conversations.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=change-me

# SQLite file. Holds both our schema and whatsmeow's own tables.
DB_PATH=./data/whats-cloud.db

# Where downloaded media is written.
MEDIA_DIR=./data/media

# Where the HTTP server listens, as host:port.
#
# The default is LOOPBACK ONLY, which is what the MCP Streamable HTTP spec asks
# for: a server bound to 0.0.0.0 is reachable by anything on the same network.
# Widen it deliberately (for example behind a reverse proxy, or inside a
# container where 0.0.0.0 is required for port publishing to work).
BIND_ADDR=127.0.0.1:8080

# Convenience: when BIND_ADDR is unset, PORT changes only the port and the host
# stays on loopback, so raising the port cannot accidentally expose the gateway.
# PORT=8080

# Origin allowlist for the /mcp endpoint, comma-separated.
#
# The MCP spec requires servers to validate the Origin header to prevent DNS
# rebinding: without it, any web page the operator visits could script requests
# against a gateway bound to localhost. Requests with NO Origin header (Claude
# Code, curl, the MCP SDK client) are always allowed; this list only governs
# browsers. Leave empty to reject every browser origin.
MCP_ALLOWED_ORIGINS=

# debug | info | warn | error
LOG_LEVEL=info
